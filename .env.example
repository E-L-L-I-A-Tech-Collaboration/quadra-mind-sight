# ============================================================
# Quadra-M.I.N.D. Sight — environment template
# Copy to .env (server) and set values before running.
#
# IMPORTANT: variables prefixed VITE_ are baked into the frontend
# at BUILD time. If you change one, rebuild (npm run build).
# Server variables (no prefix) are read at RUNTIME from .env.
# ============================================================

# ---------- Server (runtime) ----------

# Port the Express server listens on.
# Hosting platforms (Render, Railway, etc.) inject their own PORT —
# the server respects it automatically.
PORT=3000

# Gemini API key for the AI facilitator / solve / interpersonal / patterns
# endpoints. Get one at https://aistudio.google.com/apikey
# Without it, the AI features use built-in offline fallback responses.
GEMINI_API_KEY=""

# Optional: override the Gemini model (default: gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"

# Set to "production" when running the built app (npm start).
NODE_ENV="development"

# ---------- Stripe billing ($14.99/mo Premium) ----------
# Server (runtime) variables for /api/billing/*.
# Created in the Stripe dashboard (the Stripe connector is not used):
#  1. Product "M.I.N.D. Sight Premium" + recurring $14.99/month price
#     -> STRIPE_PRICE_ID (price_...)
#  2. A secret API key (restricted or secret) -> STRIPE_SECRET_KEY
#  3. Webhook endpoint: <SITE_URL>/api/billing/webhook listening to
#     checkout.session.completed, customer.subscription.created,
#     customer.subscription.updated, customer.subscription.deleted
#     -> STRIPE_WEBHOOK_SECRET (whsec_...)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Canonical public origin of the deployed app, no trailing slash.
# Used for Stripe success/cancel redirect URLs.
SITE_URL="https://quadra-mind-sight.onrender.com"

# ---------- Client (build time, VITE_*) ----------

# Your public web origin, e.g. https://your-domain.com
# Used for the PWA manifest id and OAuth redirect URLs.
VITE_APP_URL="http://localhost:3000"

# ---------- Firebase (build time, VITE_*) ----------
# (Removed: the app no longer uses Firebase/Google sign-in. Profiles are
# stored locally on-device via the built-in profile system.)
