    },
    {
      "name": "M.I.N.D.S. Facilitator",
      "shortName": "Facilitator",
      "url": "/?view=facilitator",
      "chosenIconUrl": "https://quadra-mind-sight.onrender.com/pwa-192x192.png"
    }
